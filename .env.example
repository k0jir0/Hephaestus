# Hephaestus Configuration
# Copy this file to .env and fill in your values

# AI Backend Selection
# Options: copilot, openai, claude, ollama
AI_BACKEND=copilot

# Model Selection (optional, defaults to backend's best model)
# For local upgrade trials, benchmark before promoting:
#   ollama pull qwen3-coder:30b
#   npm run models:smoke -- qwen3-coder:30b
#   npm run models:benchmark -- --models codellama:latest,qwen3-coder:30b
AI_MODEL=

# Safety Settings
DAILY_TOKEN_BUDGET=10.00
MAX_ITERATIONS=50
ERROR_THRESHOLD=5

# GitHub Copilot (if using copilot backend)
GITHUB_TOKEN=

# OpenAI (if using openai backend)
OPENAI_API_KEY=

# Anthropic Claude (if using claude backend)
ANTHROPIC_API_KEY=

# Ollama (if using ollama backend)
OLLAMA_BASE_URL=http://localhost:11434

# Project to work on (default: this repository)
TARGET_PROJECT=.

# Canonical ticket store path
TICKETS_DB_FILE=.hephaestus-tickets.db

# Keep markdown fallback explicit so ticket-store failures do not silently change behavior
ALLOW_MARKDOWN_TASK_FALLBACK=false

# Disable this when TASKS.md projection writes are noisy or locked by another process
TASK_BOARD_PROJECTION_ENABLED=true

# Logging
LOG_LEVEL=info
LOG_FILE=hephaestus.log

# Auto-commit interval in minutes (0 to disable)
AUTO_COMMIT_INTERVAL=30

# Check interval in seconds (how often to check for new tasks)
CHECK_INTERVAL=60
