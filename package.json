{
  "name": "hephaestus",
  "version": "1.0.0",
  "description": "Local-first AI engineering control plane for durable, policy-bounded software work",
  "main": "dist/agent.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "validate:config": "tsx src/config-validation.ts",
    "preflight": "tsx src/agent.ts --preflight",
    "ui": "tsx src/ui-server.ts",
    "start": "npm run build && node dist/agent.js",
    "start:daemon": "npm run build && node dist/agent.js --daemon",
    "start:once": "npm run build && node dist/agent.js --once",
    "watch": "tsc --watch",
    "dev": "tsx src/agent.ts",
    "cli": "tsx src/cli.ts",
    "dev:once": "tsx src/agent.ts --once",
    "tickets": "tsx src/tickets.ts",
    "autopilot": "tsx src/tickets.ts autopilot",
    "metrics:efficiency": "tsx src/efficiency-metrics.ts",
    "metrics:efficiency:weekly": "tsx src/efficiency-weekly-report.ts",
    "fault-harness": "tsx src/reliability-harness.ts --mode fault",
    "soak": "tsx src/reliability-harness.ts --mode soak",
    "publish:reliability": "tsx src/reliability-harness.ts --mode publish",
    "lint": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs"
  },
  "keywords": [
    "ai",
    "automation",
    "control-plane",
    "workflow",
    "developer",
    "governance",
    "tickets",
    "self-hosting"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.6.0",
    "dotenv": "^16.4.5",
    "gray-matter": "^4.0.3",
    "openai": "^4.52.7",
    "@anthropic-ai/sdk": "^0.39.0",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
