{
  "name": "hephaestus",
  "version": "1.0.0",
  "description": "Local-first AI engineering control plane for durable, policy-bounded software work",
  "main": "dist/agent.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "validate:config": "tsx src/config-validation.ts",
    "preflight": "tsx src/agent.ts --preflight",
    "ui": "tsx src/ui-server.ts",
    "start:all": "powershell -ExecutionPolicy Bypass -File start_all.ps1",
    "stop:all": "powershell -ExecutionPolicy Bypass -File stop_all.ps1",
    "status:all": "powershell -ExecutionPolicy Bypass -File start.ps1 status --strict",
    "start": "npm run build && node dist/agent.js",
    "start:daemon": "npm run build && node dist/agent.js --daemon",
    "start:once": "npm run build && node dist/agent.js --once",
    "watch": "tsc --watch",
    "dev": "tsx src/agent.ts",
    "cli": "tsx src/cli.ts",
    "dev:once": "tsx src/agent.ts --once",
    "tickets": "tsx src/tickets.ts",
    "models:report": "tsx src/model-cli.ts report",
    "models:smoke": "tsx src/model-cli.ts smoke",
    "models:benchmark": "tsx src/model-cli.ts benchmark",
    "models:recommend": "tsx src/model-cli.ts recommend",
    "models:promote": "tsx src/model-cli.ts promote",
    "models:warmup": "tsx src/model-cli.ts warmup",
    "autopilot": "tsx src/tickets.ts autopilot",
    "stage-a:pilot": "powershell -ExecutionPolicy Bypass -File scripts/stage-a-pilot.ps1",
    "stage-a:pilot:lean": "powershell -ExecutionPolicy Bypass -File scripts/stage-a-pilot.ps1 -GateProfile lean",
    "stage-a:pilot:strict": "powershell -ExecutionPolicy Bypass -File scripts/stage-a-pilot.ps1 -GateProfile strict",
    "stage-a:autopilot:loop": "powershell -ExecutionPolicy Bypass -File scripts/stage-a-autopilot-loop.ps1",
    "stage-a:autopilot:stop": "powershell -ExecutionPolicy Bypass -File scripts/stage-a-autopilot-stop.ps1",
    "stage-b:pilot": "powershell -ExecutionPolicy Bypass -File scripts/stage-b-pilot.ps1",
    "stage-b:autopilot:loop": "powershell -ExecutionPolicy Bypass -File scripts/stage-b-autopilot-loop.ps1",
    "stage-b:autopilot:stop": "powershell -ExecutionPolicy Bypass -File scripts/stage-b-autopilot-stop.ps1",
    "metrics:efficiency": "tsx src/efficiency-metrics.ts",
    "metrics:efficiency:weekly": "tsx src/efficiency-weekly-report.ts",
    "metrics:source-grounding": "tsx src/source-grounding-report.ts",
    "metrics:source-grounding:audit": "tsx src/tickets.ts audit-source-evidence --max-drifted 0 --max-missing-evidence 0",
    "metrics:d2:verify": "tsx src/tickets.ts verify-d2 --max-count-mismatches 0 --max-legacy-only 0 --max-domain-only 0 --max-missing-legacy-link 0 --min-replay-correlation-coverage 0.2",
    "metrics:d2:closure": "tsx src/d2-closure-report.ts",
    "metrics:upgrade-telemetry": "tsx src/upgrade-telemetry.ts",
    "metrics:with-vs-without": "node scripts/analyze-with-vs-without.mjs",
    "context:clean": "powershell -ExecutionPolicy Bypass -File scripts/context-clean.ps1",
    "fault-harness": "tsx src/reliability-harness.ts --mode fault",
    "soak": "tsx src/reliability-harness.ts --mode soak",
    "publish:reliability": "tsx src/reliability-harness.ts --mode publish",
    "lint": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs"
  },
  "keywords": [
    "ai",
    "automation",
    "control-plane",
    "workflow",
    "developer",
    "governance",
    "tickets",
    "self-hosting"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.6.0",
    "dotenv": "^16.4.5",
    "gray-matter": "^4.0.3",
    "openai": "^4.52.7",
    "@anthropic-ai/sdk": "^0.39.0",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
